# Copy to .env and fill in real values. NEVER commit .env.
BRIGHT_DATA_API_KEY=your_bright_data_api_token_here

# GPU vertical
COLLECTOR_NEWEGG=c_your_newegg_collector
COLLECTOR_BHPHOTO=c_your_bhphoto_collector
COLLECTOR_MINDFACTORY=c_your_mindfactory_collector

# Travel vertical (city-parametric — same collector works for any city page)
COLLECTOR_TREEBO=c_your_treebo_collector
COLLECTOR_FABHOTELS=c_your_fabhotels_collector

# Chaos demo store
COLLECTOR_CHAOS=c_your_chaos_collector
CHAOS_STORE_URL=https://hydra-chaos-store.vercel.app/

# optional
WORKER_PORT=8787
HYDRA_DB_PATH=./data/hydra.db
SCHEDULER=on
CHAOS_TEST_ENABLED=on
CHAOS_TEST_CRON=0 */6 * * *
